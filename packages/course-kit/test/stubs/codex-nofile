#!/usr/bin/env node
// Test stub for the codex CLI. Run as `codex-nofile` (identical copy), it writes nothing and reports logged out.
import { appendFileSync, writeFileSync } from 'node:fs';
import { basename, join } from 'node:path';

const NOFILE = basename(process.argv[1]) === 'codex-nofile';
const args = process.argv.slice(2);
if (process.env.CODEX_STUB_LOG) appendFileSync(process.env.CODEX_STUB_LOG, JSON.stringify({ args, cwd: process.cwd(), keys: { OPENAI_API_KEY: 'OPENAI_API_KEY' in process.env, COURSE_MEDIA_OPENAI_KEY: 'COURSE_MEDIA_OPENAI_KEY' in process.env } }) + '\n');

const PNG_1PX = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==';

if (args[0] === '--version') { process.stdout.write('codex-cli 0.0.0-stub\n'); process.exit(0); }
if (args[0] === 'login' && args[1] === 'status') process.exit(NOFILE ? 1 : 0);
if (args[0] === 'exec') {
  if (NOFILE) process.exit(0);
  const m = /Save the image as (.+)\.\s*$/.exec(args[args.length - 1] ?? '');
  if (!m) { process.stderr.write('stub: no file name in prompt\n'); process.exit(2); }
  writeFileSync(join(process.cwd(), m[1]), Buffer.from(PNG_1PX, 'base64'));
  process.exit(0);
}
process.stderr.write(`stub: unknown command ${args.join(' ')}\n`);
process.exit(2);
